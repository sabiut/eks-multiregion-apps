# The nginx image fills in ${BACKEND_URL} from the environment when the container starts.
server {
  listen 8080;
  root /usr/share/nginx/html;

  # Health check for the load balancer and the readiness probe. Answered by nginx itself,
  # so the frontend stays in service when the backend is down and can show an error.
  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # The only way from the frontend tier to the backend tier.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
  }

  location / { try_files $uri /index.html; }
}
